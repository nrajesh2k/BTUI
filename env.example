# Braintree Sandbox (or Production) credentials
# Get these from: Braintree Control Panel > Settings > API Keys
BT_ENVIRONMENT=Sandbox
BT_MERCHANT_ID=your_merchant_id
BT_PUBLIC_KEY=your_public_key
BT_PRIVATE_KEY=your_private_key

# Server port (Render sets this automatically via process.env.PORT)
PORT=3000
